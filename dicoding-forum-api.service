[Unit]
Description=Dicoding Forum API
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/var/www/dicoding-forum-api
Environment=NODE_ENV=production
Environment=PORT=5000
ExecStart=/usr/bin/node /var/www/dicoding-forum-api/src/app.js
Restart=on-failure

[Install]
WantedBy=multi-user.target
